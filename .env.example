# Optional local overrides for the Streamlit apps.
# Keep real secrets in `.env` or `.streamlit/secrets.toml`, not in Git.

TELEGRAM_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_S=15

SOC_ALERTS_CSV=alerts_history.csv
SOC_WINDOW_SECONDS=60
SOC_FAIL_THRESHOLD=6
SOC_ALERT_COOLDOWN_SECONDS=180
SOC_SCORE_THRESHOLD=4
SOC_BATCH_WAIT_SECONDS=2.0
SOC_MAX_BATCH_LINES=25
SOC_MAX_MODEL_CALLS_PER_REFRESH=2
